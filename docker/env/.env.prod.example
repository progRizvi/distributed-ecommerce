NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

DATABASE_URL=
REDIS_URL=
ELASTICSEARCH_URL=http://elasticsearch:9200

# At least 32 characters, use a strong random value
JWT_SECRET=
# Must be different from JWT_SECRET, also at least 32 characters
COOKIE_SECRET=
CORS_ORIGIN=

# Mail (required in production, "console" is refused). Example: smtps://user:pass@smtp.provider.com:465
# or smtp://user:pass@host:587?requireTLS=true  (special characters in the password must be URL-encoded)
MAIL_DRIVER=smtp
SMTP_URL=
MAIL_FROM=
