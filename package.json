{
  "name": "ecommerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --env-file-if-exists=.env src/db/seeds/run.ts",
    "docker:dev": "docker compose --env-file docker/env/.env.dev -f docker/compose.dev.yml up -d",
    "docker:prod": "docker compose --env-file docker/env/.env.prod -f docker/compose.prod.yml up -d"
  }
}
