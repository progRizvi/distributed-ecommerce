{
  "name": "ecommerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "bloom:rebuild": "tsx --env-file-if-exists=.env scripts/rebuild-email-bloom.ts",
    "outbox:dead": "tsx --env-file-if-exists=.env scripts/outbox.ts dead",
    "outbox:replay": "tsx --env-file-if-exists=.env scripts/outbox.ts replay",
    "outbox:purge-dead": "tsx --env-file-if-exists=.env scripts/outbox.ts purge-dead",
    "worker": "tsx watch --env-file-if-exists=.env src/jobs/worker.ts",
    "worker:start": "node --env-file-if-exists=.env dist/jobs/worker.js",
    "seed": "tsx --env-file-if-exists=.env src/db/seeds/run.ts",
    "docker:dev": "docker compose --env-file docker/env/.env.dev -f docker/compose.dev.yml up -d",
    "docker:prod": "docker compose --env-file docker/env/.env.prod -f docker/compose.prod.yml up -d"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@node-rs/bcrypt": "^2.0.0",
    "bullmq": "^6.4.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
