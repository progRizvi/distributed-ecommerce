# Local run without Docker app (pnpm dev). Copy to .env and edit.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgresql://ecommerce:change-me@localhost:5432/ecommerce
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# At least 32 characters
JWT_SECRET=change-me-jwt-change-me-jwt-change-me-jwt
# Must be different from JWT_SECRET
COOKIE_SECRET=change-me-cookie-change-me-cookie-change
CORS_ORIGIN=http://localhost:5173

# Optional: pnpm seed creates this admin (password at least 12 characters, never commit a real one)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
